# Copy to .env and fill in. NEVER commit .env.
OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default model for the agent (override per-experiment in configs/*.json)
AGENT_MODEL=gpt-5.6

# Optional: cap spend per run (the runner stops early if exceeded)
# AGENT_MAX_USD=5.0
